<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bgsoftware</groupId>
        <artifactId>WildTools</artifactId>
        <version>2025.2</version>
    </parent>

    <artifactId>WildTools-Plugin</artifactId>
    <packaging>jar</packaging>

    <name>WildTools-Plugin</name>

    <dependencies>
        <!-- Internal dependencies -->
        <dependency>
            <groupId>com.bgsoftware</groupId>
            <artifactId>WildToolsAPI</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- BG Software Common libraries -->
        <dependency>
            <groupId>com.bgsoftware.common.reflection</groupId>
            <artifactId>ReflectionUtils</artifactId>
            <version>b8</version>
        </dependency>
        <dependency>
            <groupId>com.bgsoftware.common.updater</groupId>
            <artifactId>Updater</artifactId>
            <version>b1</version>
        </dependency>
        <dependency>
            <groupId>com.bgsoftware.common.config</groupId>
            <artifactId>CommentedConfiguration</artifactId>
            <version>b1</version>
        </dependency>
        <dependency>
            <groupId>com.bgsoftware.common.shopsbridge</groupId>
            <artifactId>ShopsBridge</artifactId>
            <version>b20</version>
            <classifier>all</classifier>
        </dependency>
        <dependency>
            <groupId>com.bgsoftware.common.dependencies</groupId>
            <artifactId>DependenciesManager</artifactId>
            <version>b2</version>
        </dependency>
        <dependency>
            <groupId>com.bgsoftware.common.nmsloader</groupId>
            <artifactId>NMSLoader</artifactId>
            <version>b17</version>
        </dependency>

        <!-- bStats -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- Spigot API -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>v1_7_R3</artifactId>
            <version>latest</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>v1_16_R3-Tuinity</artifactId>
            <version>latest</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>WildTools-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.bgsoftware.wildtools.libs.org.bstats</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.bgsoftware.common</pattern>
                                    <shadedPattern>com.bgsoftware.wildtools.libs.com.bgsoftware.common</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
